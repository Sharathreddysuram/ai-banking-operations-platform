# =============================================================================
# AI Banking Operations Platform — environment template
#
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically. Every variable below has a
# working local-development default in docker-compose.yml, so the platform
# also starts with no `.env` file at all — this file exists so you can
# override values explicitly and so non-Docker (local) development has a
# single reference for every setting the services understand.
#
# NEVER commit a real `.env` file. `.env` is git-ignored on purpose.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# One PostgreSQL 16 instance hosts one database per service:
#   auth_db, kyc_db, fraud_db, loan_db, support_db, decision_db
# (created by infra/postgres/init.sql on first start)
# -----------------------------------------------------------------------------
# Superuser password for the postgres container itself (local dev only).
POSTGRES_PASSWORD=postgres

# Application database credentials — used by every backend service.
DB_USERNAME=bank
DB_PASSWORD=bankpass

# Per-service JDBC URLs.
#   Inside Docker Compose these are set per-service in docker-compose.yml as
#   jdbc:postgresql://postgres:5432/<service>_db and do not need editing here.
#   For local development (services running on your host) use localhost:
# DB_URL=jdbc:postgresql://localhost:5432/auth_db
# DB_URL=jdbc:postgresql://localhost:5432/kyc_db
# DB_URL=jdbc:postgresql://localhost:5432/fraud_db
# DB_URL=jdbc:postgresql://localhost:5432/loan_db
# DB_URL=jdbc:postgresql://localhost:5432/support_db
# DB_URL=jdbc:postgresql://localhost:5432/decision_db

# -----------------------------------------------------------------------------
# Kafka
# Inside Docker:  kafka:29092   (PLAINTEXT listener, Docker network only)
# On the host:    localhost:9092 (PLAINTEXT_HOST listener)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVICES=kafka:29092
# KAFKA_BOOTSTRAP_SERVICES=localhost:9092   # <- use this for local dev

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
# REDIS_HOST=localhost                      # <- use this for local dev
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Security — JWT
# -----------------------------------------------------------------------------
# WARNING: CHANGE IN PRODUCTION.
# This secret signs and verifies every JWT issued by auth-service and
# validated at the API gateway. Use a long, random value (at least 32
# characters) and give every environment its own secret. Never reuse the
# development value below anywhere outside your laptop.
JWT_SECRET=banking-platform-dev-secret-change-in-production-please-use-a-long-random-value

# -----------------------------------------------------------------------------
# AI layer — Spring AI
# -----------------------------------------------------------------------------
# AI_MODE controls how the five agents reason:
#   fallback  (default) Deterministic, in-code reasoning engine.
#             No external API key, no network call, fully testable and
#             demo-friendly. The platform runs end-to-end in this mode.
#   azure     Agents reason through Azure OpenAI via Spring AI ChatClient,
#             with tool calling. Requires the three Azure variables below.
AI_MODE=fallback

# Azure OpenAI — only required when AI_MODE=azure.
# Endpoint of your Azure OpenAI resource, e.g.
#   https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# WARNING: secret. Keep this in .env / a secret manager only — never commit it.
AZURE_OPENAI_API_KEY=
# Name of the model deployment in your Azure OpenAI resource.
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# -----------------------------------------------------------------------------
# Service URLs
# Used by api-gateway to route to downstream services, and by
# decision-service to call the KYC, fraud, loan and support services when it
# orchestrates a case.
#
# Inside Docker Compose these resolve by service name (values below are the
# Docker values). For local development, replace the hostnames with
# localhost, e.g. AUTH_SERVICE_URL=http://localhost:8081
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8081
KYC_SERVICE_URL=http://kyc-service:8082
FRAUD_SERVICE_URL=http://fraud-service:8083
LOAN_SERVICE_URL=http://loan-service:8084
SUPPORT_SERVICE_URL=http://support-service:8085
DECISION_SERVICE_URL=http://decision-service:8086
