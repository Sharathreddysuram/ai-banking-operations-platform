# =============================================================================
# EXAMPLE ONLY — do not apply this file with these placeholder values, and
# never commit a real secret.yaml to git.
#
# How to use it:
#   1. Copy this file:            cp k8s/secret.yaml.example k8s/secret.yaml
#   2. Replace the base64 values with your own:
#        echo -n 'your-value' | base64
#   3. Apply it:                  kubectl apply -f k8s/secret.yaml
#   4. k8s/secret.yaml is git-ignored. In production, prefer an external
#      secret manager (Azure Key Vault, External Secrets Operator, Sealed
#      Secrets) over a plain manifest.
#
# Placeholder values below decode to:
#   JWT_SECRET          -> change-me-in-production-use-a-long-random-secret
#   DB_PASSWORD         -> bankpass
#   AZURE_OPENAI_API_KEY -> your-azure-openai-api-key
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: banking-secrets
  namespace: banking-platform
  labels:
    app.kubernetes.io/name: ai-banking-operations-platform
    app.kubernetes.io/part-of: banking-platform
type: Opaque
data:
  # WARNING: change in production — long, random, unique per environment.
  JWT_SECRET: "Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tdXNlLWEtbG9uZy1yYW5kb20tc2VjcmV0"
  DB_PASSWORD: "YmFua3Bhc3M="
  # Only required when AI_MODE=azure in the ConfigMap.
  AZURE_OPENAI_API_KEY: "eW91ci1henVyZS1vcGVuYWktYXBpLWtleQ=="
